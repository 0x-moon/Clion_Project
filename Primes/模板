//快速幂
ll qpow(ll a,ll b,ll mod) {
    ll res=1;
    a%=mod;
    while (b) {
        if (b&1) {res=(res*a)%mod;}
        a=(a*a)%mod;
        b>>=1;
    }
}
//线性筛
int p[N], idx = 0;
bool st[N];

void solve(int n) {
    for (int i = 2; i <= n; ++i) {
        if (!st[i]) p[idx++] = i;
        for (int j = 0; p[j] <= n / i; ++j) {
            st[p[j] * i] = true;
            if (i % p[j] == 0)break;
        }
    }
}
//欧拉函数结合线性筛
int p[N], idx = 0;
bool st[N];
int phi[N];
void solve(int n) {
    phi[1] = 1;
    for (int i = 2; i <= n; ++i) {
        if (!st[i]) {
            p[idx++] = i;
            phi[i] = i - 1;
        }
        for (int j = 0; p[j] <= n / i; ++j) {
            st[p[j] * i] = true;
            if (i % p[j] == 0) {
                phi[i] = p[j] * phi[i];
                break;
            }
            phi[p[j] * i] = phi[i] / p[j] * (p[j] - 1);
        }
    }
}
